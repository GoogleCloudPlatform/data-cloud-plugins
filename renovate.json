{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    ":ignoreUnstable",
    ":separateMajorReleases",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone",
    ":preserveSemverRanges"
  ],
  "rebaseWhen": "conflicted",
  "dependencyDashboardLabels": [
    "type: process"
  ],
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "matchManagers": [
        "git-submodules",
        "custom.jsonata"
      ],
      "groupName": "{{{replace '^plugins/|-plugin$' '' depName}}}",
      "semanticCommitType": "feat"
    },
    {
      "matchManagers": [
        "git-submodules"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": [
        "/^\\.claude-plugin/marketplace\\.json$/",
        "/^\\.agents/plugins/marketplace\\.json$/"
      ],
      "matchStrings": [
        "plugins.($r := $replace(source.repo ? source.repo : source.url, /^https:\\/\\/github\\.com\\/|\\.git$/, \"\"); { \"depName\": $replace($substringAfter($r, \"/\"), /-plugin$/, \"\"), \"packageName\": $r, \"currentValue\": source.ref })"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
